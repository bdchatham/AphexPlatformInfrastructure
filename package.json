{
  "name": "arbiter-pipeline-infrastructure",
  "version": "0.1.0",
  "description": "CDK infrastructure for Arbiter deployment pipelines",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration",
    "test:integration:check": "bash test/integration/check-prerequisites.sh",
    "test:integration:setup": "bash test/integration/setup-kind-cluster.sh",
    "test:integration:cleanup": "bash test/integration/cleanup-kind-cluster.sh",
    "test:integration:keep": "CLEANUP_INTEGRATION_CLUSTER=false jest --testPathPattern=integration",
    "test:integration:full": "npm run test:integration:setup && npm run test:integration && npm run test:integration:cleanup",
    "cdk": "cdk",
    "build:images": "bash scripts/build-images.sh",
    "build:images:push": "bash scripts/build-images.sh --push"
  },
  "keywords": [
    "cdk",
    "aws",
    "eks",
    "argo",
    "pipeline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "aws-cdk": "^2.117.0",
    "fast-check": "^4.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@aws-cdk/lambda-layer-kubectl-v28": "^2.2.1",
    "@aws-cdk/lambda-layer-kubectl-v30": "^2.0.4",
    "aws-cdk-lib": "^2.117.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
