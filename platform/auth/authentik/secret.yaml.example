apiVersion: v1
kind: Secret
metadata:
  name: authentik-secrets
  namespace: auth-system
type: Opaque
stringData:
  # Generate a secure random secret key (50+ characters recommended)
  # Example generation: openssl rand -base64 50
  secret-key: "REPLACE_WITH_GENERATED_SECRET_KEY"
  
  # Initial admin password (change after first login via Authentik UI)
  # Example generation: openssl rand -base64 32
  admin-password: "REPLACE_WITH_GENERATED_ADMIN_PASSWORD"
