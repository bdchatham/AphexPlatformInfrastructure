apiVersion: v1
kind: Secret
metadata:
  name: authentik-postgresql
  namespace: auth-system
  labels:
    app: postgresql
    platform.arbiter.io/component: "authentication"
    platform.arbiter.io/managed-by: "bootstrap"
type: Opaque
stringData:
  # PostgreSQL password for the authentik user
  # Generate with: openssl rand -base64 32
  postgresql-password: "REPLACE_WITH_GENERATED_PASSWORD"
  
  # PostgreSQL superuser password (for administrative tasks)
  # Generate with: openssl rand -base64 32
  postgresql-postgres-password: "REPLACE_WITH_GENERATED_PASSWORD"

---
# Example generation commands:
# 
# Generate a secure password:
#   openssl rand -base64 32
#
# Create the secret in Kubernetes:
#   kubectl create secret generic authentik-postgresql \
#     --from-literal=postgresql-password=$(openssl rand -base64 32) \
#     --from-literal=postgresql-postgres-password=$(openssl rand -base64 32) \
#     --namespace=auth-system
#
# Or use the bootstrap script which will generate these automatically
