apiVersion: v1
kind: Secret
metadata:
  name: dex-secrets
  namespace: auth-system
type: Opaque
stringData:
  # Authentik OIDC client secret for Dex
  # Generate with: openssl rand -base64 32
  authentik-client-secret: "REPLACE_WITH_GENERATED_SECRET"
  
  # ArgoCD OIDC client secret
  # Generate with: openssl rand -base64 32
  argocd-client-secret: "REPLACE_WITH_GENERATED_SECRET"
  
  # Tekton Dashboard OIDC client secret
  # Generate with: openssl rand -base64 32
  tekton-client-secret: "REPLACE_WITH_GENERATED_SECRET"
