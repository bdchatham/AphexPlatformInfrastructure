# Build outputs
dist/
build/
*.pyc
# Only ignore compiled JS/TS declaration files in lib/lib (the build output directory)
lib/lib/
*.js
*.d.ts
# But don't ignore TypeScript source files
!lib/**/*.ts
!bin/**/*.ts
!test/**/*.ts

