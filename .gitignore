# Dependencies
node_modules/
venv/
__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.local

# Build outputs
dist/
build/
*.pyc

# Ignore all compiled JavaScript and TypeScript declaration files
*.js
*.d.ts

# But keep TypeScript source files
!*.ts

# Ignore the entire lib/ directory (it contains compiled output)
# The actual source is in the root lib/ as .ts files which we'll explicitly include
lib/lib/
lib/bin/

# Keep TypeScript source files in lib/ (not in lib/lib/ or lib/bin/)
!lib/*.ts
!lib/**/*.ts

# Keep TypeScript source files in bin/ and test/
!bin/**/*.ts
!test/**/*.ts

# Explicitly ignore compiled files that might be in source directories
lib/lib/**
lib/bin/**

# CDK
cdk.out/
.cdk.staging/
cdk.context.json

# Test coverage
coverage/
.nyc_output/
*.lcov

# Python
*.egg-info/
.pytest_cache/
